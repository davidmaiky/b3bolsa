generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// assetClass: B3 | US | CRYPTO | FX
model Asset {
  id           String         @id @default(cuid())
  ticker       String         @unique // PETR4, AAPL, BTC, USD
  name         String?
  assetClass   String
  currency     String // BRL | USD
  watchlist    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  transactions Transaction[]
  fundamentals Fundamentals?
  suggestions  Suggestion[]
  dividends    Dividend[]
  alerts       Alert[]
  peerCache    PeerCache?
  fiiInfo      FiiInfo?
}

model Transaction {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type      String // BUY | SELL
  quantity  Float
  price     Float // in the asset currency
  fees      Float    @default(0)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
}

model Fundamentals {
  assetId   String   @id
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  data      String // JSON
  updatedAt DateTime @updatedAt
}

model Suggestion {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action     String // COMPRAR | MANTER | VENDER
  confidence Float
  targetPrice Float?
  rationale  String
  risks      String // JSON array
  indicators String // JSON snapshot sent to the LLM
  model      String
  createdAt  DateTime @default(now())
}

// Proventos recebidos. date = data do evento (ex-data ou pagamento); perShare e tax na moeda do ativo.
model Dividend {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type      String // DIVIDENDO | JCP | RENDIMENTO | OUTRO
  date      DateTime
  perShare  Float
  quantity  Float
  tax       Float    @default(0) // imposto retido na fonte (total)
  source    String   @default("manual") // manual | yahoo
  note      String?
  createdAt DateTime @default(now())

  @@index([assetId, date])
}

// Meta de alocação por classe de ativo (B3 | US | CRYPTO | FX), em % da carteira.
model AllocationTarget {
  assetClass String @id
  percent    Float
}

// Alerta de preço de uso único. type: ABOVE | BELOW | BELOW_BAZIN | BELOW_GRAHAM (os dois últimos usam o valor calculado dos fundamentos).
model Alert {
  id           String    @id @default(cuid())
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type         String
  target       Float? // preço-alvo na moeda do ativo (ABOVE/BELOW)
  note         String?
  active       Boolean   @default(true)
  triggeredAt  DateTime?
  triggerPrice Float?
  seenAt       DateTime? // quando o disparo foi visto/dispensado na tela
  createdAt    DateTime  @default(now())

  @@index([active])
}

// Perfil do investidor (uma linha, id "me"): vai no prompt do Gemini.
model InvestorProfile {
  id               String   @id @default("me")
  risk             String // CONSERVADOR | MODERADO | ARROJADO
  objective        String // RENDA | CRESCIMENTO | BALANCEADO | PRESERVACAO
  horizonYears     Int
  maxPositionPct   Float? // concentração máxima desejada por ativo (%)
  notes            String?
  updatedAt        DateTime @updatedAt
}

// Comparação com pares (mediana de P/L, P/VP, DY...) guardada por ativo para não repetir chamadas ao Yahoo.
model PeerCache {
  assetId   String   @id
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  data      String // JSON
  updatedAt DateTime @updatedAt
}

// Dados de FII que o Yahoo não traz (vêm do relatório gerencial mensal do fundo): preenchidos à mão.
model FiiInfo {
  assetId           String   @id
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vacancyPhysical   Float? // %
  vacancyFinancial  Float? // %
  segment           String?
  updatedAt         DateTime @updatedAt
}

// Aplicação em renda fixa de banco (CDB, LCI, LCA...). Cada aplicação é um registro: o valor é calculado pelas condições do contrato.
model FixedIncome {
  id           String    @id @default(cuid())
  kind         String // CDB | LCI | LCA | CRI | CRA | DEBENTURE | OUTRO
  issuer       String // banco/emissor
  label        String? // apelido
  indexer      String // PRE | CDI_PCT | CDI_PLUS
  rate         Float // PRE: % a.a. | CDI_PCT: % do CDI (ex.: 110) | CDI_PLUS: taxa % a.a. somada ao CDI
  principal    Float // valor aplicado (R$)
  startDate    DateTime
  maturityDate DateTime
  liquidity    String    @default("MATURITY") // DAILY | MATURITY
  fgc          Boolean   @default(true)
  note         String?
  redeemedAt   DateTime?
  redeemedNet  Float? // valor líquido recebido no resgate
  createdAt    DateTime  @default(now())

  @@index([redeemedAt])
}

// Séries do Banco Central (ex.: 12 = CDI diário em % a.d.), guardadas para não depender da API a cada tela.
model RateCache {
  code      Int      @id
  data      String // JSON [{date, close}]
  fromDate  String // início do período guardado
  updatedAt DateTime @updatedAt
}
