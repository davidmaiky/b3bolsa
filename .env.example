# Banco local (SQLite)
DATABASE_URL="file:./dev.db"

# London Strategic Edge — crie a chave em https://londonstrategicedge.com/data (Databank)
LSE_API_KEY=""

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Acesso ao site: se APP_PASSWORD estiver definida, o login é obrigatório (deixe vazia para desativar)
# AUTH_SECRET assina o cookie de sessão: gere com `openssl rand -hex 32`
APP_PASSWORD=""
AUTH_SECRET=""

# Alertas por Telegram (opcional): crie um bot com @BotFather e pegue seu chat id com @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
